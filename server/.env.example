# ---------------------------------------------------------------------------
# BinMan API — environment configuration
# Copy to `.env` and fill in. NEVER commit the populated file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins.
#   3000 = webapp (marketing + driver PWA)
#   3001 = admin console
# The mobile app sends no Origin header, so it is not affected by this list.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://binman:binman@localhost:5432/binman?schema=public

# --- Redis (cache, rate limiting, BullMQ) ----------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP -------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# In development the OTP is returned in the API response and logged instead of
# being sent over SMS. MUST be false in staging/production.
OTP_DEBUG_RETURN=true

# --- Money -----------------------------------------------------------------
CURRENCY=NGN
# Flat platform fee added to every booking, in minor units (kobo). 50000 = ₦500
DEFAULT_SERVICE_FEE=50000

# --- Booking rules ---------------------------------------------------------
# How many hours before the slot start a customer may still cancel for free.
CANCELLATION_WINDOW_HOURS=2
# How far ahead a customer may schedule.
MAX_ADVANCE_BOOKING_DAYS=30
# Minutes after booking creation before an unpaid booking is auto-expired.
PAYMENT_EXPIRY_MINUTES=30

# --- Flutterwave -----------------------------------------------------------
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxx
# The "secret hash" configured on the Flutterwave dashboard webhook settings.
# Incoming webhooks are rejected unless their verif-hash header matches.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=replace-me
#
# NOTE: there is no FLUTTERWAVE_WEBHOOK_URL variable. Flutterwave calls US, so
# the URL is registered on their dashboard (Settings -> Webhooks), not here.
# It is always:  <public API origin>/api/v1/payments/webhook
#   local    https://<your-tunnel>.ngrok-free.app/api/v1/payments/webhook
#   staging  https://api-staging.binman.ng/api/v1/payments/webhook
#   prod     https://api.binman.ng/api/v1/payments/webhook
# Flutterwave cannot reach localhost, so a tunnel is required in development.
#
# Where Flutterwave redirects the CUSTOMER'S BROWSER after checkout. This is a
# frontend page, not an API route, and is unrelated to the webhook above.
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/payments/callback

# --- WhatsApp Cloud API ----------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back to Meta during webhook subscription verification.
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=
WHATSAPP_SESSION_TTL_SECONDS=1800

# --- Sendchamp (SMS + email) -----------------------------------------------
# Providers: log | sendchamp. `log` writes messages to the console instead of
# sending them — the default for development.
SMS_PROVIDER=log
EMAIL_PROVIDER=log
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1
# Sendchamp calls this the "public key", but it IS the secret API credential.
# Never ship it to a client application.
SENDCHAMP_PUBLIC_KEY=
# Must be a sender ID approved on your Sendchamp account.
# Sendchamp rejects any sender ID it has not approved for your account with a
# 400 "invalid sender name", on every send. "Sendchamp" is their shared default
# and always works; register "BinMan" in the dashboard and switch to it once it
# is approved — Nigerian networks show this string as the message sender.
SENDCHAMP_SENDER_NAME=Sendchamp
# dnd reaches subscribers on the Do-Not-Disturb list — required for OTPs to
# arrive on Nigerian networks. non_dnd is cheaper but drops those users.
SENDCHAMP_SMS_ROUTE=dnd
SENDCHAMP_FROM_EMAIL=noreply@binman.ng
SENDCHAMP_FROM_NAME=BinMan

# --- Push notifications (Firebase Cloud Messaging) -------------------------
# Providers: log | fcm
#
# All three values come from ONE service-account JSON file:
#   1. https://console.firebase.google.com  -> select (or create) your project
#   2. Gear icon -> Project settings -> "Service accounts" tab
#   3. Click "Generate new private key" -> downloads a .json file
#   4. Copy three fields out of that JSON:
#        "project_id"    -> FCM_PROJECT_ID
#        "client_email"  -> FCM_CLIENT_EMAIL   (...@....iam.gserviceaccount.com)
#        "private_key"   -> FCM_PRIVATE_KEY
#
# Treat that JSON like a password: it can send a notification to every BinMan
# user. Never commit it, and delete the download once the values are in place.
#
# FCM_PRIVATE_KEY gotcha: the JSON stores newlines as the two characters \ + n.
# Paste the value EXACTLY as it appears (escaped \n intact), wrapped in double
# quotes, all on one line. The server unescapes it at boot.
#   FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# The mobile app needs its own separate Firebase config (google-services.json
# on Android, GoogleService-Info.plist on iOS). These server keys only SEND;
# they do not let a device receive.
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Cloudinary (proof of collection, profile photos) ----------------------
# Drivers: local | cloudinary. Use cloudinary everywhere except local dev —
# proof photos are dispute evidence and must not live on an ephemeral disk.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder prefix, so one Cloudinary account can host several
# environments without them colliding. e.g. binman-staging
CLOUDINARY_FOLDER=binman

# --- Mapbox ----------------------------------------------------------------
# Used for geocoding addresses, reverse geocoding "use my location", and
# driving ETAs. Kept server-side; the app calls /api/v1/geo/* instead of
# holding the token itself.
MAPBOX_ACCESS_TOKEN=
MAPBOX_COUNTRY=ng

# --- Seeded admin console credentials --------------------------------------
# Used by `npm run seed`. The seeded account is flagged mustChangePassword, so
# whoever signs in first must replace this before they can use the console.
# Override both in any real deployment.
SEED_ADMIN_EMAIL=admin@binman.com
SEED_ADMIN_PASSWORD=Admin@123dev

# How long a single Redis command may take before being abandoned.
# 5000 suits a hosted Redis (Upstash etc.) over TLS from another region — the
# first command after connect can take >1.5s. Drop to ~1000 for a local Redis.
REDIS_COMMAND_TIMEOUT_MS=5000
