// ---------------------------------------------------------------------------
// BinMan — waste collection & home services platform
//
// MONEY: every monetary column is an Int in MINOR units (kobo). ₦2,500 => 250000.
// This avoids float drift and Decimal serialisation noise across the API.
// Convert at the presentation edge only.
//
// TIME: `scheduledDate` is a date-only value (stored at UTC midnight). The
// actual window comes from the joined TimeSlot. Everything else is a timestamp.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Role {
  CUSTOMER
  DRIVER
  CLEANER
  DISPATCHER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  PHONE_CHANGE
}

enum ServiceType {
  WASTE_COLLECTION
  CLEANING
}

/// Full booking lifecycle. See prd.md §14.
enum BookingStatus {
  PENDING_PAYMENT
  PAID
  PENDING_ASSIGNMENT
  ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  COLLECTED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  FLUTTERWAVE
  WALLET
  CASH
}

enum WasteType {
  HOUSEHOLD
  FOOD
  PLASTIC
  PAPER
  CARDBOARD
  MIXED
  GARDEN
  COMMERCIAL
  OTHER
}

enum CollectionSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
  CUSTOM
}

enum CleaningType {
  REGULAR
  DEEP
  OFFICE
  MOVE_IN
  MOVE_OUT
  POST_EVENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  OFFICE
  SHOP
  OTHER
}

enum PropertySize {
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
  FOUR_PLUS_BEDROOM
  CUSTOM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DriverAvailability {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

enum TruckStatus {
  AVAILABLE
  ASSIGNED
  ON_ROUTE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  FAILED
  REASSIGNED
  CANCELLED
}

enum FailureReason {
  CUSTOMER_UNAVAILABLE
  WRONG_ADDRESS
  ACCESS_PROBLEM
  WASTE_UNAVAILABLE
  VEHICLE_ISSUE
  OTHER
}

enum SubscriptionFrequency {
  WEEKLY
  TWICE_WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// ===========================================================================
// IDENTITY & ACCESS
// ===========================================================================

model User {
  id           String     @id @default(cuid())
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  /// E.164, e.g. +2348012345678. Primary identifier across app + WhatsApp.
  phone        String     @unique
  email        String?    @unique
  /**
   * bcrypt hash, set only for back-office staff.
   *
   * Customers and drivers authenticate by OTP and never have one — phone
   * ownership is the proof. Staff sign in to the admin console with email and
   * password because they work at a desk, often on a shared machine, where
   * waiting for an SMS every session is friction with no security benefit.
   */
  passwordHash String?    @map("password_hash")
  /** Forces a password change on next sign-in. Set on any seeded account. */
  mustChangePassword Boolean @default(false) @map("must_change_password")
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(PENDING)
  profileImage String?    @map("profile_image")
  /// Firebase Cloud Messaging device token for push notifications.
  pushToken    String?    @map("push_token")
  /// Set false to opt out of a channel entirely.
  pushEnabled  Boolean    @default(true) @map("push_enabled")
  smsEnabled   Boolean    @default(true) @map("sms_enabled")
  whatsappEnabled Boolean @default(true) @map("whatsapp_enabled")
  emailEnabled Boolean    @default(true) @map("email_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  addresses         Address[]
  bookings          Booking[]
  payments          Payment[]
  subscriptions     Subscription[]
  notifications     Notification[]
  reviews           Review[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  driver            Driver?
  supportTickets    SupportTicket[]  @relation("TicketOwner")
  assignedTickets   SupportTicket[]  @relation("TicketAssignee")
  assignmentsMade   BookingAssignment[] @relation("AssignedBy")
  cleaningJobs      BookingAssignment[] @relation("AssignedCleaner")
  statusChanges     BookingStatusHistory[]
  whatsappSessions  WhatsappSession[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// SHA-256 of the issued token. The raw token never touches the database.
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model OtpVerification {
  id         String     @id @default(cuid())
  phone      String
  /// bcrypt hash — never store the plaintext code (trsa.md §4).
  otpHash    String     @map("otp_hash")
  purpose    OtpPurpose @default(LOGIN)
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  verifiedAt DateTime?  @map("verified_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_verifications")
}

// ===========================================================================
// GEOGRAPHY
// ===========================================================================

/// Operating areas. Bookings outside an active area are rejected or waitlisted
/// (admin.md §7). Matching is by (city, area) name, case-insensitive.
model ServiceArea {
  id           String   @id @default(cuid())
  name         String
  city         String
  state        String
  isActive     Boolean  @default(true) @map("is_active")
  /// Added to the base price for this area, in kobo. May be 0.
  surcharge    Int      @default(0)
  /// When inactive, should new requests be waitlisted instead of rejected?
  waitlist     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses    Address[]
  bookings     Booking[]
  pricingRules PricingRule[]

  @@unique([city, name])
  @@index([isActive])
  @@map("service_areas")
}

model Address {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  label         String
  addressLine   String   @map("address_line")
  area          String
  city          String
  state         String
  latitude      Float?
  longitude     Float?
  instructions  String?
  contactName   String?  @map("contact_name")
  contactPhone  String?  @map("contact_phone")
  isDefault     Boolean  @default(false) @map("is_default")
  serviceAreaId String?  @map("service_area_id")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea?  @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  subscriptions Subscription[]

  @@index([userId, deletedAt])
  @@map("addresses")
}

// ===========================================================================
// SCHEDULING & PRICING
// ===========================================================================

model TimeSlot {
  id        String   @id @default(cuid())
  label     String
  /// Minutes from midnight, e.g. 07:00 => 420. Timezone-free by design.
  startTime Int      @map("start_time")
  endTime   Int      @map("end_time")
  isActive  Boolean  @default(true) @map("is_active")
  /// Capacity is enforced PER DATE by counting live bookings on that date.
  maxBookings Int    @default(20) @map("max_bookings")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings      Booking[]
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("time_slots")
}

/// Admin-configurable pricing. Prices are NEVER hardcoded in a client
/// (prd.md §12). Resolution picks the most specific active rule that matches.
model PricingRule {
  id             String          @id @default(cuid())
  serviceType    ServiceType     @map("service_type")
  /// Waste dimensions — null means "matches any".
  wasteType      WasteType?      @map("waste_type")
  collectionSize CollectionSize? @map("collection_size")
  /// Cleaning dimensions — null means "matches any".
  cleaningType   CleaningType?   @map("cleaning_type")
  propertySize   PropertySize?   @map("property_size")
  /// Null means the rule applies nationwide.
  serviceAreaId  String?         @map("service_area_id")
  /// Kobo.
  basePrice      Int             @map("base_price")
  serviceFee     Int             @default(0) @map("service_fee")
  currency       String          @default("NGN")
  isActive       Boolean         @default(true) @map("is_active")
  effectiveFrom  DateTime        @default(now()) @map("effective_from")
  effectiveTo    DateTime?       @map("effective_to")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  serviceArea ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@index([serviceType, isActive])
  @@map("pricing_rules")
}

// ===========================================================================
// BOOKINGS
// ===========================================================================

model Booking {
  id             String        @id @default(cuid())
  /// Human-facing, e.g. WST1024 / CLN0042.
  reference      String        @unique
  userId         String        @map("user_id")
  serviceType    ServiceType   @map("service_type")
  addressId      String        @map("address_id")
  serviceAreaId  String?       @map("service_area_id")
  /// Date-only (UTC midnight); the window comes from timeSlot.
  scheduledDate  DateTime      @map("scheduled_date") @db.Date
  timeSlotId     String        @map("time_slot_id")
  status         BookingStatus @default(PENDING_PAYMENT)
  /// All kobo. total = subtotal + serviceFee - discount.
  subtotal       Int
  serviceFee     Int           @default(0) @map("service_fee")
  discount       Int           @default(0)
  totalAmount    Int           @map("total_amount")
  currency       String        @default("NGN")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  notes          String?
  subscriptionId String?       @map("subscription_id")
  cancelledAt    DateTime?     @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id])
  address         Address                @relation(fields: [addressId], references: [id])
  serviceArea     ServiceArea?           @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  timeSlot        TimeSlot               @relation(fields: [timeSlotId], references: [id])
  subscription    Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  wasteBooking    WasteBooking?
  cleaningBooking CleaningBooking?
  assignments     BookingAssignment[]
  statusHistory   BookingStatusHistory[]
  payments        Payment[]
  proofs          CollectionProof[]
  failures        CollectionFailure[]
  review          Review?
  supportTickets  SupportTicket[]

  @@index([userId, status])
  @@index([scheduledDate, timeSlotId])
  @@index([status, scheduledDate])
  @@index([serviceAreaId, scheduledDate])
  @@map("bookings")
}

model WasteBooking {
  id                  String         @id @default(cuid())
  bookingId           String         @unique @map("booking_id")
  /// A pickup may mix categories (ui.md §15).
  wasteTypes          WasteType[]    @map("waste_types")
  collectionSize      CollectionSize @map("collection_size")
  estimatedQuantity   String?        @map("estimated_quantity")
  specialInstructions String?        @map("special_instructions")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("waste_bookings")
}

model CleaningBooking {
  id                  String       @id @default(cuid())
  bookingId           String       @unique @map("booking_id")
  cleaningType        CleaningType @map("cleaning_type")
  propertyType        PropertyType @map("property_type")
  propertySize        PropertySize @map("property_size")
  numberOfRooms       Int?         @map("number_of_rooms")
  specialInstructions String?      @map("special_instructions")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("cleaning_bookings")
}

model BookingStatusHistory {
  id         String         @id @default(cuid())
  bookingId  String         @map("booking_id")
  oldStatus  BookingStatus? @map("old_status")
  newStatus  BookingStatus  @map("new_status")
  changedBy  String?        @map("changed_by")
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ===========================================================================
// FLEET & DISPATCH
// ===========================================================================

model Driver {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  licenseNumber      String?            @map("license_number")
  licenseExpiry      DateTime?          @map("license_expiry")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  availabilityStatus DriverAvailability @default(OFFLINE) @map("availability_status")
  currentLatitude    Float?             @map("current_latitude")
  currentLongitude   Float?             @map("current_longitude")
  lastLocationAt     DateTime?          @map("last_location_at")
  /// Truck the driver is normally paired with; per-job truck lives on the
  /// assignment so history stays accurate after a reassignment.
  defaultTruckId     String?            @map("default_truck_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultTruck Truck?              @relation("DefaultDriver", fields: [defaultTruckId], references: [id], onDelete: SetNull)
  assignments  BookingAssignment[]
  locations    DriverLocation[]

  @@index([availabilityStatus])
  @@map("drivers")
}

model DriverLocation {
  id         String   @id @default(cuid())
  driverId   String   @map("driver_id")
  bookingId  String?  @map("booking_id")
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt])
  @@map("driver_locations")
}

model Truck {
  id                 String      @id @default(cuid())
  truckNumber        String      @unique @map("truck_number")
  registrationNumber String      @unique @map("registration_number")
  truckType          String      @map("truck_type")
  /// Free-text capacity description, e.g. "5 tonnes".
  capacity           String?
  status             TruckStatus @default(AVAILABLE)
  currentLatitude    Float?      @map("current_latitude")
  currentLongitude   Float?      @map("current_longitude")
  lastServiceDate    DateTime?   @map("last_service_date")
  nextServiceDue     DateTime?   @map("next_service_due")
  maintenanceNotes   String?     @map("maintenance_notes")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  assignments    BookingAssignment[]
  defaultDrivers Driver[]            @relation("DefaultDriver")

  @@index([status])
  @@map("trucks")
}

/// One row per dispatch attempt. A reassignment closes the old row
/// (REASSIGNED) and opens a new one, so the audit trail survives.
model BookingAssignment {
  id          String           @id @default(cuid())
  bookingId   String           @map("booking_id")
  /// Waste collection uses driver + truck; cleaning uses cleaner.
  driverId    String?          @map("driver_id")
  truckId     String?          @map("truck_id")
  cleanerId   String?          @map("cleaner_id")
  assignedBy  String?          @map("assigned_by")
  status      AssignmentStatus @default(PENDING)
  assignedAt  DateTime         @default(now()) @map("assigned_at")
  acceptedAt  DateTime?        @map("accepted_at")
  enRouteAt   DateTime?        @map("en_route_at")
  arrivedAt   DateTime?        @map("arrived_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  truck    Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)
  cleaner  User?   @relation("AssignedCleaner", fields: [cleanerId], references: [id], onDelete: SetNull)
  assigner User?   @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  proofs   CollectionProof[]
  failures CollectionFailure[]

  @@index([bookingId, status])
  @@index([driverId, status])
  @@index([cleanerId, status])
  @@map("booking_assignments")
}

/// Photo + GPS + timestamp evidence that the job was really done
/// (prd.md §16, driver.md §6).
model CollectionProof {
  id                String   @id @default(cuid())
  bookingId         String   @map("booking_id")
  assignmentId      String?  @map("assignment_id")
  photoUrls         String[] @map("photo_urls")
  latitude          Float?
  longitude         Float?
  capturedAt        DateTime @default(now()) @map("captured_at")
  customerConfirmed Boolean  @default(false) @map("customer_confirmed")
  signatureUrl      String?  @map("signature_url")
  notes             String?
  submittedBy       String?  @map("submitted_by")
  createdAt         DateTime @default(now()) @map("created_at")

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignment BookingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("collection_proofs")
}

/// A driver may only fail a job with a reason (driver.md §7).
model CollectionFailure {
  id           String        @id @default(cuid())
  bookingId    String        @map("booking_id")
  assignmentId String?       @map("assignment_id")
  reason       FailureReason
  description  String?
  photoUrls    String[]      @map("photo_urls")
  latitude     Float?
  longitude    Float?
  reportedBy   String?       @map("reported_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignment BookingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("collection_failures")
}

// ===========================================================================
// PAYMENTS
// ===========================================================================

model Payment {
  id                    String          @id @default(cuid())
  bookingId             String?         @map("booking_id")
  userId                String          @map("user_id")
  /// Our own idempotent reference, sent to the provider as tx_ref.
  reference             String          @unique
  provider              PaymentProvider @default(FLUTTERWAVE)
  amount                Int
  currency              String          @default("NGN")
  status                PaymentStatus   @default(PENDING)
  /// Flutterwave's numeric transaction id, known only after a charge attempt.
  providerTransactionId String?         @map("provider_transaction_id")
  providerReference     String?         @map("provider_reference")
  channel               String?
  checkoutUrl           String?         @map("checkout_url")
  /// Raw provider payloads, kept for dispute resolution.
  providerResponse      Json?           @map("provider_response")
  failureReason         String?         @map("failure_reason")
  paidAt                DateTime?       @map("paid_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([bookingId])
  @@index([providerTransactionId])
  @@map("payments")
}

/// Every inbound webhook is persisted before processing. The unique
/// (provider, eventKey) pair is what makes redelivery idempotent
/// (trsa.md §10).
model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventKey    String        @map("event_key")
  eventType   String?       @map("event_type")
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([provider, eventKey])
  @@index([provider, createdAt])
  @@map("webhook_events")
}

// ===========================================================================
// SUBSCRIPTIONS
// ===========================================================================

model Subscription {
  id            String                @id @default(cuid())
  userId        String                @map("user_id")
  serviceType   ServiceType           @map("service_type")
  frequency     SubscriptionFrequency
  /// 0 = Sunday … 6 = Saturday. For TWICE_WEEKLY, both days are listed.
  daysOfWeek    Int[]                 @map("days_of_week")
  timeSlotId    String                @map("time_slot_id")
  addressId     String                @map("address_id")
  /// Snapshot of the per-occurrence price, in kobo.
  amount        Int
  currency      String                @default("NGN")
  /// Waste details replayed onto each generated booking.
  wasteTypes    WasteType[]           @map("waste_types")
  collectionSize CollectionSize?      @map("collection_size")
  status        SubscriptionStatus    @default(ACTIVE)
  startDate     DateTime              @map("start_date") @db.Date
  endDate       DateTime?             @map("end_date") @db.Date
  nextRunDate   DateTime?             @map("next_run_date") @db.Date
  lastRunAt     DateTime?             @map("last_run_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address  Address   @relation(fields: [addressId], references: [id])
  timeSlot TimeSlot  @relation(fields: [timeSlotId], references: [id])
  bookings Booking[]

  @@index([status, nextRunDate])
  @@index([userId])
  @@map("subscriptions")
}

// ===========================================================================
// COMMUNICATION & SUPPORT
// ===========================================================================

model Notification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  channel   NotificationChannel
  type      String
  title     String
  message   String
  status    NotificationStatus  @default(QUEUED)
  metadata  Json?
  error     String?
  /// The provider's own id for the sent message (Sendchamp / FCM). Delivery
  /// webhooks arrive keyed by this, so it is how a callback finds its row.
  providerMessageId String?     @map("provider_message_id")
  sentAt    DateTime?           @map("sent_at")
  /// Set when the provider confirms the message actually reached the handset
  /// or inbox — SENT only means we handed it over.
  deliveredAt DateTime?         @map("delivered_at")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([providerMessageId])
  @@map("notifications")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  photoUrls String[] @map("photo_urls")
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@map("reviews")
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique @map("ticket_number")
  userId       String         @map("user_id")
  bookingId    String?        @map("booking_id")
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  assignedTo   String?        @map("assigned_to")
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user     User     @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?    @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@map("support_tickets")
}

/// Conversation state for the WhatsApp bot. The bot holds no business logic —
/// it only tracks where the customer is in a flow (whatsapp.md).
model WhatsappSession {
  id           String   @id @default(cuid())
  phone        String   @unique
  userId       String?  @map("user_id")
  currentState String   @default("IDLE") @map("current_state")
  sessionData  Json     @default("{}") @map("session_data")
  lastMessageId String? @map("last_message_id")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("whatsapp_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
